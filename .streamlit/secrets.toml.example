# Copy to secrets.toml and fill in. NEVER commit secrets.toml.
# On Streamlit Cloud, paste these same lines into Settings -> Secrets.

GOOGLE_API_KEY  = "your-gemini-key"
MONGODB_URI     = "mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?appName=Cluster0"
FINNHUB_API_KEY = "your-finnhub-key"

# Optional: gates the app behind a shared password. Uncomment to require one -
# anyone with the link can otherwise use the app and spend your API quota.
# APP_PASSWORD  = "choose-something"
